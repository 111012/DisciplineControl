<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃：半透明渐变 + 1dp 高光描边 + 大圆角 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#C2FFFFFF"
        android:centerColor="#8AFFFFFF"
        android:endColor="#5CFFFFFF"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#B3FFFFFF" />
</shape>
