<?xml version="1.0" encoding="utf-8"?>
<!-- Dock 栏：比普通玻璃更实的胶囊，保证图标清楚 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F2FFFFFF"
        android:centerColor="#D9FFFFFF"
        android:endColor="#BFFFFFFF"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#F2FFFFFF" />
</shape>
